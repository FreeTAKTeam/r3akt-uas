<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- DJI SDK registration needs the network; it runs only when a djiApiKey is built in. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DJI SDK 4 touches Bluetooth while opening the controller's USB link; up to Android 11 that
         needs these install-time permissions ("aoa connect error Need BLUETOOTH permission" on a Galaxy S8). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <application>
        <!-- Supplied from the djiApiKey Gradle property; empty by default. -->
        <meta-data android:name="com.dji.sdk.API_KEY" android:value="${djiApiKey}" />

        <uses-library android:name="com.android.future.usb.accessory" android:required="false" />
        <uses-library android:name="org.apache.http.legacy" android:required="false" />

        <!-- Hands the remote controller's USB accessory connection to the DJI SDK. -->
        <activity
            android:name="dji.sdk.sdkmanager.DJIAoaControllerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>
    </application>
</manifest>
